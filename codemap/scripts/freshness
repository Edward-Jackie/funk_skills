#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["PyYAML>=6.0.2,<7"]
# ///
"""计算 CODEMAP 新鲜度：领先提交、基线天数、变化/失效锚点与统一等级。"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from freshness_lib import LEVELS, SEVERITY, compute, find_root, render_text  # noqa: E402


def map_dir_of(path: Path | None, root: Path) -> Path:
    if path is None:
        return root / ".map"
    target = path.expanduser().resolve()
    if target.is_file():
        target = target.parent
    if target.name in {"graphs", "overlays"}:
        target = target.parent
    return target


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("path", nargs="?", type=Path, help="CODEMAP.md、.map 目录或 Graph 目录；默认 <root>/.map")
    parser.add_argument("--root", type=Path, help="项目根目录；默认自动识别 Git 根")
    parser.add_argument("--map-root", type=Path, help="地图根目录，优先于 path")
    parser.add_argument("--deep", action="store_true", help="用 where.sh 校验符号是否仍有定义式匹配")
    parser.add_argument("--no-anchors", action="store_true", help="跳过锚点扫描，只看元数据与领先度")
    parser.add_argument("--json", action="store_true", help="输出 JSON")
    parser.add_argument("--fail-on", choices=LEVELS, help="等级达到或超过该值时退出码为 1")
    args = parser.parse_args()

    probe = args.map_root.expanduser().resolve() if args.map_root else (args.path.expanduser().resolve() if args.path else Path.cwd())
    root = args.root.expanduser().resolve() if args.root else find_root(probe)
    map_dir = map_dir_of(args.map_root or args.path, root)
    if not map_dir.is_dir():
        print(f"地图目录不存在：{map_dir}", file=sys.stderr)
        return 2

    data = compute(root, map_dir, deep=args.deep, scan_anchors=not args.no_anchors)
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
    else:
        print(render_text(data))
    if args.fail_on and SEVERITY[data["level"]] >= SEVERITY[args.fail_on]:
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
